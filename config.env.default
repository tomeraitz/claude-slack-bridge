# claude-slack-bridge configuration — template.
#
# Copy this to your own config and edit that copy; nothing installs or upgrades
# over it:
#
#   mkdir -p ~/.config/claude-slack-bridge
#   cp "$(brew --prefix claude-slack-bridge)/libexec/config.env.default" \
#      ~/.config/claude-slack-bridge/config.env
#   chmod 600 ~/.config/claude-slack-bridge/config.env
#
# Plain KEY=VALUE only. This file is read by `docker compose --env-file`, which
# does not run a shell over it: no `export`, no $VAR, no ~, no command
# substitution, no quotes-as-syntax. Paths must be written out in full.

# --- required: Slack ---
# Both tokens come from your Slack app: the bot token from OAuth & Permissions,
# the app-level token (connections:write) from Basic Information. See
# docs/slack-setup.md.
SLACK_BOT_TOKEN=xoxb-REPLACE-ME
SLACK_APP_TOKEN=xapp-REPLACE-ME

# Default channel for Claude → Slack questions. Per-project .mcp.json files
# override it, and normally do.
SLACK_CHANNEL=#general

# --- required: projects ---
# The PARENT directory holding your projects. It is mounted into the container
# at /projects, so the paths in projects.json are container paths: a project at
# /Users/you/Workspace/api is /projects/api in the mapping.
#
# Set this even if you only use the Claude → Slack direction: the container will
# not start without it. Point it somewhere real — an absent path is created as
# an empty directory by Docker rather than reported as a mistake.
PROJECTS_DIR=/Users/you/Workspace

# The channel → project mapping itself is NOT set here. It lives next to this
# file, as ~/.config/claude-slack-bridge/projects.json, and is created empty on
# first start. Edit it, then apply it live — no restart, no dropped Slack
# connection, no killed runs:
#
#   claude-slack-bridge reload

# --- access control ---
# This matters more here than it looks. The Slack → Claude direction runs
# `claude -p` against your files, on your machine, as you. Left unguarded,
# anyone who can post in a channel the app is installed in can drive it.
#
# So this template ships closed: enabled, strict, and with empty lists, which
# denies everyone. Add your own Slack user ID (Slack profile → ⋮ → Copy member
# ID) and the channels you want the bot to answer in, or the bot will refuse
# you too.
SECURITY_ENABLED=true
# Strict: an empty allowlist denies all. false: an empty allowlist allows all.
SECURITY_STRICT_MODE=true
# Comma-separated Slack user IDs, e.g. U0123ABC,U0456DEF
SECURITY_ALLOWED_USERS=
# Comma-separated channel IDs the bot answers in, e.g. C0123ABC,C0456DEF
SECURITY_ALLOWED_CHANNELS=
# User IDs that bypass the channel allowlist
SECURITY_ADMIN_USERS=
SECURITY_REJECTION_MESSAGE=You are not authorized to use this bot.
SECURITY_LOG_UNAUTHORIZED=true

# --- live progress & run lifetime ---
# On: while a run works, the bridge edits one status message in the thread
# (recent actions, files/churn/tool/error tally) from the CLI's event stream —
# no extra model calls — and puts a 🛑 reaction on it that stops the run. Off:
# no status message; stop via 🛑 on the triggering message instead.
LIVE_PROGRESS=true
PROGRESS_INTERVAL_SECONDS=10
# Recent actions listed, newest first; older ones collapse into "… and N more".
PROGRESS_ACTIONS=99
# There is no wall-clock timeout — a run lives until it finishes or you stop it.
# This is only a stuck-run watchdog: seconds with NO activity at all. Long
# builds emit nothing while running, so keep it generous. 0 disables it.
IDLE_TIMEOUT_SECONDS=1800

# --- logging ---
# INFO: lifecycle only (sessions, channel mapping, errors).
# DEBUG: also every Claude event as it arrives (assistant text, thinking,
#        tool_use, tool_result) — for debugging Slack → Claude runs.
LOG_LEVEL=INFO

# --- GitHub (optional) ---
# Fine-grained PAT used by `gh` and `git push` inside the container. Needed only
# for the /process workflow, which opens PRs and reads review comments. Leave it
# empty otherwise — but leave the line in place, or compose warns on every
# start. See docs/github-setup.md.
GITHUB_TOKEN=
